# =================================================================
# 1. CONFIGURAÇÕES DE SISTEMA E AMBIENTE
# =================================================================
# Define o contexto de execução da aplicação (Valores aceitos: DEV, PRODUCTION, TEST)
AMBIENTE=DEV

# Tempo de vida padrão (TTL) para itens armazenados em cache (em segundos)
# Exemplo: 28800 segundos = 8 horas
CACHE_TTL=28800

# =================================================================
# 2. SEGURANÇA, CORS E AUTENTICAÇÃO
# =================================================================
# Origens/Domínios autorizados a realizar requisições CORS para esta API (separados por vírgula)
