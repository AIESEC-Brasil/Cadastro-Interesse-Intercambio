# Chaves de API autorizadas para autenticar clientes em endpoints protegidos (separadas por vírgula)
API_KEYS_PERMITIDAS=AIESECNOBRASIL

# =================================================================
# 3. BANCO DE DADOS
# =================================================================
# String de conexão (Ex: mysql+mysqlconnector://user:pass@host:port/db)
#DB_CONNECT=

# Validação prévia de conexão (true/false)
#DB_POOL_PRE_PING=

# Tempo de reciclagem do pool de conexões em segundos
#DB_POOL_RECYCLE=

